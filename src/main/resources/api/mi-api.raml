#%RAML 1.0
title: exchangeMuleJava
version: v1
baseUri: https://api.coppel.com/exchange-mule-java
mediaType: application/json

/hello:
  get:
    description: Devuelve un saludo simple.
    responses:
      200:
        body:
          application/json:
            type: object
            properties:
              message: string
            example:
              message: "Hello World with Exchange"
